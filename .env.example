# Copy this file to .env and fill in real values.
# `cp .env.example .env`

# ---------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------

# Postgres connection string. Any managed Postgres works (Railway, Render,
# Supabase, RDS), or a local install for development. The schema is
# created automatically on first run.
DATABASE_URL=postgres://user:password@localhost:5432/gem_seeker

# Optional, but REQUIRED if DATABASE_URL above points at a transaction-mode
# connection pooler — Neon's built-in PgBouncer (hostname contains
# "-pooler"), Supabase's Supavisor, or a hand-rolled PgBouncer in
# transaction mode. Set this to the DIRECT (non-pooled) connection string
# for the same database — on Neon that's the same URL with "-pooler"
# removed from the hostname; check your provider's dashboard for the exact
# direct string otherwise. Used only by src/db/advisoryLock.js for its
# session-level locks, which transaction-mode pooling does not support: the
# physical backend can be silently swapped between statements even on one
# held client connection, which defeats the lock with no error raised
# anywhere. If DATABASE_URL is NOT behind a transaction-mode pooler (plain
# Postgres, a session-mode pooler, most local/VM setups), leave this unset —
# advisoryLock.js falls back to DATABASE_URL and works fine.
# DIRECT_DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/gem_seeker

# Message @BotFather on Telegram, /newbot
TELEGRAM_BOT_TOKEN=

# aistudio.google.com/app/apikey
GEMINI_API_KEY=

# A dedicated RPC provider — do NOT use the public mainnet-beta endpoint in
# production, it will rate-limit you. Helius/QuickNode/Alchemy free tiers
# all work.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional — a SEPARATE RPC endpoint/key for scripts/backfill-early-wallets.js
# only, from a different provider account than SOLANA_RPC_URL above (e.g. a
# team member's own Helius key). Use this if the backfill's request volume
# is competing with the live bot for the same rate-limit budget — Helius
# free tier is 10 req/s shared across everything using one key, and the
# live bot's own scanning traffic runs continuously while a backfill sweep
# is going. Leave unset to keep using SOLANA_RPC_URL for the backfill too
# (today's default, nothing changes if you don't set this).
BACKFILL_SOLANA_RPC_URL=

# Automatic early-wallet reconstruction is opt-in. It processes a small,
# resumable batch of tracked tokens per hour and writes early_wallet_activity.
# EARLY_WALLET_BACKFILL_ENABLED=false
# EARLY_WALLET_BACKFILL_INTERVAL_MS=3600000
# EARLY_WALLET_BACKFILL_START_DELAY_MS=15000
# EARLY_WALLET_BACKFILL_BATCH_SIZE=5
# EARLY_WALLET_BACKFILL_WINDOW_MINUTES=30
# EARLY_WALLET_BACKFILL_MIN_SOL=0.5
# EARLY_WALLET_BACKFILL_SIG_CAP=50
# EARLY_WALLET_BACKFILL_MAX_TX_PARSE=50
# EARLY_WALLET_BACKFILL_MAX_RPC_REQUESTS=500
# EARLY_WALLET_BACKFILL_MAX_ELAPSED_MS=600000
# EARLY_WALLET_BACKFILL_MAX_DB_WRITES=10000
# EARLY_WALLET_BACKFILL_PAGE_SLEEP_MS=500
# EARLY_WALLET_BACKFILL_TX_SLEEP_MS=250

# Your public Solana wallet address that receives subscription payments.
# Public address only — never put a private key anywhere in this project.
PAYMENT_WALLET_ADDRESS=

# ---------------------------------------------------------------------
# Optional — Postgres tuning
# ---------------------------------------------------------------------

# Set to "true" if your Postgres provider requires SSL (most managed
# providers do). Uses rejectUnauthorized: false to work with providers
# that use self-signed/intermediate certs (e.g. Render, Railway).
# DATABASE_SSL=true

# Max connections in the pool. Default 10 — fine for a single bot
# instance; raise only if you know you need to.
# DATABASE_POOL_MAX=10

# PostgreSQL connection safety defaults. Values are milliseconds.
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_QUERY_TIMEOUT_MS=35000
# DATABASE_KEEP_ALIVE=true
# DATABASE_APPLICATION_NAME=gem-seeker

# Horizontal sharding for early_wallet_activity only (item 41) — comma-
# separated Postgres connection strings for EXTRA shards (1..N-1). Shard
# 0 is always the primary DATABASE_URL above, never listed here. Leave
# unset until you've actually provisioned extra database(s) and are
# ready to run scripts/migrate-early-wallet-activity-to-shards.js —
# unset means shardCount()=1 and everything behaves exactly as before
# this feature existed. Uses the same DATABASE_SSL/DATABASE_POOL_MAX
# settings above for every extra shard. See src/db/shardPool.js's header
# comment for the full design (why wallet_address is the shard key, why
# it's a fixed shard count rather than consistent hashing).
# EARLY_WALLET_SHARD_URLS=postgres://user:password@host1:5432/gem_seeker_shard1,postgres://user:password@host2:5432/gem_seeker_shard2

# ---------------------------------------------------------------------
# Optional — one-off backfill/diagnostic scripts only, not read by the bot itself
# ---------------------------------------------------------------------

# Used by scripts/backfill-recover-description.js (and the earlier
# throwaway scripts/_diagnostic_metaplex_description_recovery.js spike it
# grew out of). Free tier at helius.dev. If SOLANA_RPC_URL above already
# points at a Helius endpoint, copy the api-key= value from that URL
# instead of signing up again.
# HELIUS_API_KEY=

# Safety budgets for scripts/backfill-early-wallets.js only. These are not
# read by the live bot. The script stops cleanly when any budget is reached;
# page checkpoints make the next run resumable.
# BACKFILL_MAX_RPC_REQUESTS=100000
# BACKFILL_MAX_ELAPSED_MS=21600000
# BACKFILL_MAX_DB_WRITES=1000000

# scripts/backfill-narrative-gemini.js (reuses the required
# GEMINI_API_KEY above) accepts an optional LIMIT env var — caps unique
# Gemini calls per run (not rows updated, thanks to dedup), default 50.
# Not a .env setting, pass it inline: LIMIT=100 node scripts/backfill-narrative-gemini.js

# ---------------------------------------------------------------------
# Optional — everything below has a working default in src/config.js.
# Uncomment and change only what you need to tune.
# ---------------------------------------------------------------------

# rugcheck.xyz dashboard -> API. Optional for light use, needed at higher
# scan volume before you get rate-limited.
# RUGCHECK_API_KEY=

# Client-side Rugcheck throttling (rugcheckService.js) — defaults are
# conservative guesses, not a verified limit from Rugcheck. Check your
# own dashboard for your key's actual req/min and tune these to match.
# RUGCHECK_MIN_REQUEST_INTERVAL_MS=1100
# RUGCHECK_FALLBACK_BACKOFF_MS=15000
# RUGCHECK_MAX_BACKOFF_MS=300000
# RUGCHECK_FAILURE_CACHE_TTL_MS=300000

# Comma-separated Telegram chat IDs with unlimited alerts + admin commands
# (/admin, /report). Find your chat ID via @userinfobot.
# ADMIN_CHAT_IDS=

# GEMINI_MODEL=gemini-2.0-flash
# SCAN_INTERVAL_MS=30000
# SUBSCRIPTION_PRICE_USD=5
# SUBSCRIPTION_DAYS=30
# TRIAL_ALERT_COUNT=50
# PATTERN_REVIEW_INTERVAL_MS=10800000
# PATTERN_MAX_TRACKING_AGE_MS=2592000000
# REPORTS_ENABLED=true
# REPORT_CHECK_INTERVAL_MS=3600000

# Tier 2, Phase 13 — Market State Engine. Computes/stores daily
# per-narrative aggregates (see src/core/marketStateEngine.js); nothing
# reads this yet (feeds a future /insights), safe to leave on.
# MARKET_STATE_ENABLED=true
# MARKET_STATE_INTERVAL_MS=3600000

# Tier 2, Phase 4 — Observation Engine. ON BY DEFAULT — this is a real
# product decision, not just a feature flag: a qualifying Medium/High-risk
# token doesn't alert immediately, it's held for OBSERVATION_WINDOW_MS and
# only alerts if it still passes a fresh safety check once that window
# elapses. Leaving this line commented out means it's ON (config.js
# defaults to true). Set OBSERVATION_ENABLED=false below to go back to
# every risk tier alerting immediately. See src/core/observationEngine.js
# and README.md's "Observation engine" section for the full reasoning.
# OBSERVATION_ENABLED=true
# OBSERVATION_RISK_LEVELS=Medium,High
# OBSERVATION_WINDOW_MS=180000

# Alert-BROADCAST filter only (see src/core/alertPolicy.js) — does NOT
# affect tracking/archiving/pattern stats, which run for every risk class
# and verdict regardless. Comma-separated, case-insensitive. Leaving both
# commented out means every class and verdict is sent, same as always.
# A token must match BOTH lists to be sent.
# CLASS_ALERTS=Low,Medium,High
# VERDICT_ALERTS=BUY,WAIT,SKIP

# ---------------------------------------------------------------------
# Optional — "Social Score" feature (off by default; purely additive,
# never affects which tokens qualify or get tracked). All five sources
# (Reddit, Twitter/X, Telegram, Google Trends, trading-volume velocity)
# are real implementations now — see SCRAPERS.md for the original
# implementation guide and each source's own setup notes below.
# ---------------------------------------------------------------------

# Master switch — must be "true" for ANY social source to run at all.
# SOCIAL_SIGNALS_ENABLED=false

# Reddit — real today, no API key needed (public JSON endpoints).
# SOCIAL_REDDIT_ENABLED=false
# SOCIAL_REDDIT_SUBREDDITS=solana,CryptoMoonShots,SolanaMemeCoins
# SOCIAL_REDDIT_TIMEOUT_MS=8000

# Twitter/X — real (src/services/twitterScraperService.js), via
# @the-convocation/twitter-scraper. Logs in as a real X account (use a
# throwaway account — see that file's header comment on ban risk). Either
# set TWITTER_COOKIES_JSON (lower ban risk, but cookies expire) or
# TWITTER_USERNAME/PASSWORD (+ EMAIL/TOTP_SECRET if your account needs
# them to clear X's login challenge).
# SOCIAL_TWITTER_ENABLED=false
# TWITTER_USERNAME=
# TWITTER_PASSWORD=
# TWITTER_EMAIL=
# TWITTER_TOTP_SECRET=
# TWITTER_COOKIES_JSON=

# Telegram — real (src/services/telegramScraperService.js), via teleproto
# (MTProto user-account API). One-time setup: get TELEGRAM_API_ID/
# TELEGRAM_API_HASH from https://my.telegram.org, then run
# `node scripts/telegram-session-login.js` once to interactively log in
# and print a TELEGRAM_SESSION_STRING — after that, no further login step.
# SOCIAL_TELEGRAM_ENABLED=false
# SOCIAL_TELEGRAM_CHANNELS=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_STRING=

# Google Trends — real (src/services/googleTrendsService.js), via
# google-trends-api. No account/API key needed, but see that file's
# header comment for why this source rarely has anything to say about a
# token that just launched, even once it's working correctly.
# SOCIAL_GOOGLE_TRENDS_ENABLED=false
# SOCIAL_GOOGLE_TRENDS_WINDOW_MINUTES=240

# Weights for the combined 0-10 Social Score. Only used across sources
# that actually produced a reading that cycle (renormalized automatically
# — see src/services/socialSignals.js).
# SOCIAL_WEIGHT_TWITTER=0.30
# SOCIAL_WEIGHT_TELEGRAM=0.20
# SOCIAL_WEIGHT_GOOGLE_TRENDS=0.15
# SOCIAL_WEIGHT_REDDIT=0.15
# SOCIAL_WEIGHT_VOLUME_GROWTH=0.20

# ---------------------------------------------------------------------
# Legacy — only read by `npm run migrate`, not by the running bot.
# Only relevant if you're upgrading from the pre-Postgres JSON-file
# version of this project and have existing data/*.json files to import.
# ---------------------------------------------------------------------

# DB_FILE=./data/subscribers.json
# PATTERN_DB_FILE=./data/tracked_tokens.json
# PATTERN_ARCHIVE_FILE=./data/pattern_archive.json
# REPORT_STATE_FILE=./data/report_state.json

# ---------------------------------------------------------------------
# Production rollout and monitoring alerts
# ---------------------------------------------------------------------
# Keep workers in dry-run during canary; set false only after validation.
# RESEARCH_OBSERVATION_DRY_RUN=true
# NOTIFICATION_WORKER_DRY_RUN=true
# ROLLOUT_MAX_GEMINI_INVALID_RATIO=0.10
# ROLLOUT_MAX_GEMINI_ERROR_RATIO=0.20
# ROLLOUT_MAX_PENDING_QUEUE=100

# ---------------------------------------------------------------------
# GeckoTerminal/CoinGecko early-discovery EXPERIMENT — standalone script
# only (scripts/early-discovery-experiment.js), never read by `npm start`.
# See docs/early-discovery-experiment.md for the full design. All optional;
# the primary GeckoTerminal path needs no key at all.
# ---------------------------------------------------------------------
# EARLY_DISCOVERY_DRY_RUN=true
# EARLY_DISCOVERY_POLL_INTERVAL_MS=60000
# EARLY_DISCOVERY_MAX_CYCLES=0
# GECKOTERMINAL_NETWORK=solana
# GECKOTERMINAL_MIN_REQUEST_INTERVAL_MS=6000
# Free signup at coingecko.com — enables the fallback path only; unset
# means the fallback is simply skipped and the primary path runs alone.
# COINGECKO_DEMO_API_KEY=

# ---------------------------------------------------------------------
# EDPI wallet-population selection + position-lifecycle reconstruction
# (research/shadow-only — see docs/edpi-position-lifecycle.md). All
# optional; wallet selection is live, position-lifecycle economics are
# not yet wired into the hot path (see that doc).
# ---------------------------------------------------------------------
# EDPI_POSITION_TOP_HOLDER_COUNT=20
# EDPI_POSITION_MIN_SOL_AMOUNT=0.5
# EDPI_POSITION_MAJOR_EXIT_FRACTION=0.4
# EDPI_POSITION_BUYBACK_MIN_HOLDING_MS=10800000

# ---------------------------------------------------------------------
# Variables read by the current code that earlier revisions of this file did
# not document. Every line is commented out and shows the DEFAULT the code
# uses when the variable is unset, so copying this file changes no behaviour.
# Boolean flags: read each note — some default ON when unset.
# ---------------------------------------------------------------------

# --- Workers / delivery ---
# Outbox/Telegram queueing worker dry-run. Defaults to dry-run: it is only
# live when this is exactly `false` (no whitespace). Separate from
# NOTIFICATION_WORKER_DRY_RUN above, which gates actual Telegram delivery.
# WORKER_DRY_RUN=true
# NOTIFICATION_POLL_MS=1000
# How often (at most) the notification worker sweeps for deliveries stranded
# in 'sending' whose 15-minute send lease expired (crash / hung send), and
# revives their jobs. Skipped entirely in dry-run.
# NOTIFICATION_RECLAIM_INTERVAL_MS=60000
# RESEARCH_OBSERVATION_POLL_MS=1000
# HEALTH_PORT=8080

# --- Discovery filters / versions ---
# DISCOVERY_FILTER_VERSION=discovery-v1
# DEXSCREENER_DISCOVERY_VERSION=dexscreener-discovery-v1
# QUALIFICATION_FILTER_VERSION=qualification-v1
# DISCOVERY_MIN_COMPARISON_SAMPLE=30

# --- GeckoTerminal discovery in the production scan path (default: OFF) ---
# GECKOTERMINAL_DISCOVERY_ENABLED=false
# GECKO_DISCOVERY_VERSION=gecko-discovery-v1
# GECKO_MIN_VOLUME_1H_USD=100
# GECKO_MIN_TOTAL_VOLUME_USD=1000
# GECKOTERMINAL_TIMEOUT_MS=10000
# GECKOTERMINAL_FALLBACK_BACKOFF_MS=15000
# GECKOTERMINAL_MAX_BACKOFF_MS=300000

# --- EDPI-L / EDPI live / wallet clustering ---
# NOTE the defaults: EDPI_L_ENABLED, EDPI_LIVE_ENABLED and
# WALLET_CLUSTERING_ENABLED are ON unless set to exactly `false`;
# EDPI_CTO_ENABLED and both *_GEMINI_CONTEXT_ENABLED flags are OFF unless
# set to exactly `true`.
# EDPI_L_ENABLED=true
# EDPI_L_GEMINI_CONTEXT_ENABLED=false
# EDPI_L_SCORING_VERSION=edpi-l-scoring-v1
# EDPI_L_STRENGTH_VERSION=edpi-l-strength-v1
# EDPI_CTO_ENABLED=false
# EDPI_LIVE_ENABLED=true
# EDPI_LIVE_GEMINI_CONTEXT_ENABLED=false
# EDPI_LIVE_CAMPAIGN_WINDOW_MS=1800000
# EDPI_LIVE_COMPARABLE_ENTRY_BAND_MULTIPLIER=3
# EDPI_LIVE_MAX_WALLETS_FOR_HISTORY=50
# EDPI_LIVE_WALLET_BASELINE_MIN_SAMPLE=3
# EDPI_BEHAVIORAL_RECENT_POSITION_COUNT=5
# EDPI_BEHAVIORAL_SIMILAR_SIZE_DISPERSION_MAX=0.3
# WALLET_CLUSTERING_ENABLED=true
# WALLET_CLUSTERING_MIN_TOKEN_COUNT=2

# --- Pattern archive ---
# PATTERN_EARLY_LIFE_REVIEW_INTERVAL_MS=900000
# PATTERN_EARLY_LIFE_WINDOW_MS=10800000
# PATTERN_SURVIVED_MIN_PCT_OF_ATH=0.5
# PATTERN_SURVIVED_SUSTAINED_HOURS=72

# --- Shadow model file locations (defaults: the bundled models/ files) ---
# FLIP_SHADOW_MODEL_PATH=
# FLIP_FEATURE_MODEL_PATH=
# FLIP_WALLET_SHADOW_MODEL_PATH=

# --- Social scraper microservice (leave unset if not deployed) ---
# TWIKIT_SERVICE_URL=


# Canonical wallet evidence depth (shared by EDPI-L / CTO / future wallet intelligence).
# Target counts unique wallet-level economic transactions, NOT raw RPC transactions.
WALLET_ACTIVITY_EVIDENCE_ENABLED=true
WALLET_ACTIVITY_EVIDENCE_TARGET=1000
WALLET_ACTIVITY_EVIDENCE_RAW_PAGE_SIZE=1000
WALLET_ACTIVITY_EVIDENCE_MAX_RAW=20000
WALLET_ACTIVITY_EVIDENCE_MAX_PAGES=25
WALLET_ACTIVITY_EVIDENCE_MAX_PAIRS=100
WALLET_ACTIVITY_EVIDENCE_WINDOW_MAX_TX_PARSE=20000
WALLET_ACTIVITY_EVIDENCE_WINDOW_MINUTES=30
WALLET_ACTIVITY_EVIDENCE_MIN_SOL=0.5
WALLET_ACTIVITY_EVIDENCE_PAGE_SLEEP_MS=500
WALLET_ACTIVITY_EVIDENCE_TX_SLEEP_MS=250

# Background job switches. All default to true (unchanged behaviour); only the literal value "false" turns one off.
# RESEARCH_WORKER_ENABLED=true                 # schedules alert-observation jobs from alert events
# RESEARCH_OBSERVATION_WORKER_ENABLED=true     # processes research jobs (alert/discovery observations, EDPI-L persistence, wallet evidence capture)
# DISCOVERY_EVENTS_ENABLED=true                # writes discovery_events (+ enqueues discovery outcome jobs); also feeds platform-activity features
# DISCOVERY_EVALUATIONS_ENABLED=true           # writes discovery_evaluations (per-stage pass/fail)
